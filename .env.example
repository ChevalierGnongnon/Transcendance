# ==========================
# Domain configuration
# ==========================

# Domain name or IP address used to access the application
DOMAIN_NAME=localhost


# ==========================
# MariaDB configuration
# ==========================

# Name of the MariaDB database
MARIADB_DATABASE=app_db

# Username used by the backend to connect to MariaDB
MARIADB_USER=app_user

# Service name of the MariaDB server
DB_HOST=db

# Port on which MariaDB accepts connections (default: 3306)
DB_PORT=3306

# ==========================
# Backend configuration
# ==========================

# Host address the backend binds to
BACKEND_HOST=0.0.0.0

# Port on which the backend server listens
BACKEND_PORT=8000


# ==========================
# Frontend configuration
# ==========================

# Host address the frontend server binds to
FRONTEND_HOST=0.0.0.0

# Port on which the frontend server listens
FRONTEND_PORT=3000


# ==========================
# Google Gemini API
# ==========================

# API key used to authenticate requests to Google Gemini
# Obtain your key from https://aistudio.google.com/apikey
# Keep the actual key secret and never commit it to version control
GEMINI_API_KEY=
