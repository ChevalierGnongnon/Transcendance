// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  admin
  user
  moderator
  guest
}

model User {
  id             String   @id @default(uuid()) @db.Char(36)
  type           UserRole @default(user)
  email          String   @unique @db.VarChar(255)
  firstName      String?  @map("first_name") @db.VarChar(50)
  lastName       String?  @map("last_name") @db.VarChar(50)
  passwordHash   String   @map("password_hash") @db.VarChar(255)
  pseudo         String   @unique @db.VarChar(30)
  profilePhotoId String?  @map("profile_photo_id") @db.Char(36)
  birthdate      DateTime @db.Date
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  isDeleted      Boolean  @default(false) @map("is_deleted")

  uploadedFiles File[]

  profilePhoto File?        @relation("UserProfilePhoto", fields: [profilePhotoId], references: [id], onDelete: SetNull)
  messages     Message[]    @relation("MessageSender")
  chatMembers  ChatMember[]
  aiConversations AiConversation[]
  aiUsage AiUsage[]
  games Game[]
  sentFriendships     Friendship[] @relation("SentFriendships")
  receivedFriendships Friendship[] @relation("ReceivedFriendships")

  @@map("user")
}

enum FileType {
  profile_photo
  default_avatar
  message
}

model File {
  id         String    @id @default(uuid()) @db.Char(36)
  name       String    @map("file_name") @db.VarChar(255)
  type       FileType
  userId     String    @map("user_id") @db.Char(36)
  chatId     String?   @map("chat_id")
  mimeType   String    @map("mime_type") @db.VarChar(100)
  expiresAt  DateTime? @map("expires_at")
  uploadedAt DateTime  @default(now()) @map("uploaded_at")

  uploader User @relation(fields: [userId], references: [id], onDelete: Cascade)

  profileFor User[] @relation("UserProfilePhoto")
  chat       Chat?   @relation(fields: [chatId], references: [id], onDelete: SetNull)

  @@unique([name, type])
  @@map("file")
}

model Chat {
  id        String   @id @default(uuid()) @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members  ChatMember[]
  messages Message[]
  file     File[]

  @@map("chats")
}

model ChatMember {
  chatId             String   @map("chat_id") @db.Char(36)
  userId             String   @map("user_id") @db.Char(36)
  joinedAt           DateTime @default(now()) @map("joined_at")
  lastReadMessagesId String?  @map("last_read_message_id")

  chat    Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [lastReadMessagesId], references: [id])

  @@id([chatId, userId])
  @@map("chat_members")
}

enum MessageType {
  text
  image
  file
  audio
  invitation
}

model Message {
  id        String      @id @default(uuid()) @db.Char(36)
  chatId    String      @map("chat_id") @db.Char(36)
  senderId  String      @map("sender_id") @db.Char(36)
  content   String      @db.Text
  type      MessageType
  createdAt DateTime    @default(now()) @map("created_at")

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  chatMembers ChatMember[]

  @@index([chatId, createdAt])
  @@map("messages")
}


enum GameResult {
    won
    lost
}

enum AiMessageRole {
  user
  assistant
}

model AiConversation {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  title     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]
  usage AiUsage[]

  @@index([userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(uuid()) @db.Char(36)
  role           AiMessageRole
  conversationId String         @map("conversations_id") @db.Char(36)
  content        String         @db.Text
  createdAt      DateTime       @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

model AiUsage {
  id String @id @default(uuid()) @db.Char(36)

  userId         String @map("user_id") @db.Char(36)
  conversationId String @map("conversation_id") @db.Char(36)

  inputTokens    Int
  outputTokens   Int
  totalTokens    Int
  thinkingTokens Int

  createdAt      DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([conversationId])
  @@index([createdAt])
  @@map("ai_usage")
}

model Game {
    id        String     @id @default(uuid()) @db.Char(36)
    userId    String     @map("user_id") @db.Char(36)
    result    GameResult
    createdAt DateTime   @default(now()) @map("created_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([createdAt])
    @@map("games")
}
enum FriendshipStatus {
  pending
  accepted
  refused
  cancelled
  blocked
}

model Friendship {
  id       String           @id @default(uuid())
  userId   String           @map("user_id")
  friendId String           @map("friend_id")
  status   FriendshipStatus @default(pending)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")

  user   User @relation("SentFriendships", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("ReceivedFriendships", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId, status])
  @@index([friendId, status])
  @@map("friendships")
}
