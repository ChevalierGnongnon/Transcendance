// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  admin
  user
  moderator
  guest
}

model User {
  id             String   @id @default(uuid()) @db.Char(36)
  type           UserRole @default(user)
  email          String   @unique @db.VarChar(255)
  firstName      String?  @map("first_name") @db.VarChar(50)
  lastName       String?  @map("last_name") @db.VarChar(50)
  passwordHash   String   @map("password_hash") @db.VarChar(255)
  pseudo         String   @unique @db.VarChar(30)
  profilePhotoId String?  @map("profile_photo_id") @db.Char(36)
  birthdate      DateTime @db.Date
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  isDeleted      Boolean  @default(false) @map("is_deleted")

  uploadedFiles File[]

  profilePhoto File?        @relation("UserProfilePhoto", fields: [profilePhotoId], references: [id], onDelete: SetNull)
  messages     Message[]    @relation("MessageSender")
  chatMembers  ChatMember[]

  sentFriendRequests     FriendRequest[] @relation("sentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("receivedFriendRequests")

  friendshipsAsUser   Friendship[] @relation("friendshipsAsUser")
  friendshipsAsFriend Friendship[] @relation("friendshipsAsFriend")

  blocksCreated  Block[] @relation("blocksCreated")
  blocksReceived Block[] @relation("blocksReceived")

  @@map("user")
}

enum FileType {
  profile_photo
  default_avatar
  message
}

model File {
  id         String    @id @default(uuid()) @db.Char(36)
  name       String    @map("file_name") @db.VarChar(255)
  type       FileType
  userId     String    @map("user_id") @db.Char(36)
  chatId     String?   @map("chat_id") @db.Char(36)
  mimeType   String    @map("mime_type") @db.VarChar(100)
  expiresAt  DateTime? @map("expires_at")
  uploadedAt DateTime  @default(now()) @map("uploaded_at")

  uploader User @relation(fields: [userId], references: [id], onDelete: Cascade)

  profileFor User[] @relation("UserProfilePhoto")
  chat       Chat?  @relation(fields: [chatId], references: [id], onDelete: SetNull)

  @@unique([name, type])
  @@map("file")
}

model Chat {
  id        String   @id @default(uuid()) @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members  ChatMember[]
  messages Message[]
  file     File[]

  @@map("chats")
}

model ChatMember {
  chatId             String   @map("chat_id") @db.Char(36)
  userId             String   @map("user_id") @db.Char(36)
  joinedAt           DateTime @default(now()) @map("joined_at")
  lastReadMessagesId String?  @map("last_read_message_id")

  chat    Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [lastReadMessagesId], references: [id])

  @@id([chatId, userId])
  @@map("chat_members")
}

enum MessageType {
  text
  image
  file
  audio
  invitation
}

model Message {
  id        String      @id @default(uuid()) @db.Char(36)
  chatId    String      @map("chat_id") @db.Char(36)
  senderId  String      @map("sender_id") @db.Char(36)
  content   String      @db.Text
  type      MessageType
  createdAt DateTime    @default(now()) @map("created_at")

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  chatMembers ChatMember[]

  @@index([chatId, createdAt])
  @@map("messages")
}

model Friendship {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  friendId  String   @map("friend_id") @db.Char(36)
  createdAt DateTime @default(now())

  user   User @relation("friendshipsAsUser", fields: [userId], references: [id])
  friend User @relation("friendshipsAsFriend", fields: [friendId], references: [id])

  @@unique([userId, friendId])
  @@index([friendId])
  @@map("friendships")
}

model FriendRequest {
  id String @id @default(uuid()) @db.Char(36)

  senderId   String @map("sender_id") @db.Char(36)
  receiverId String @map("receiver_id") @db.Char(36)

  sender   User @relation("sentFriendRequests", fields: [senderId], references: [id])
  receiver User @relation("receivedFriendRequests", fields: [receiverId], references: [id])

  createdAt DateTime @default(now())

  @@unique([senderId, receiverId])
  @@index([receiverId])
  @@map("friend_request")
}

model Block {
  id        String   @id @default(uuid()) @db.Char(36)
  blockerId String   @map("blocker_id") @db.Char(36)
  blockedId String   @map("blocked_id") @db.Char(36)
  createdAt DateTime @default(now())

  blocker User @relation("blocksCreated", fields: [blockerId], references: [id])
  blocked User @relation("blocksReceived", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("block")
}
